# Copy this file to .env and fill in the values. Never commit the real key.

# Required — the app refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — HTTP port the app listens on (default: 3000).
PORT=3000

# Optional — set to "production" for raw NDJSON logs instead of pretty output,
# or "test" to silence logs entirely.
NODE_ENV=
