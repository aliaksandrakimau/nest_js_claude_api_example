# Copy this file to .env and fill in the values. Never commit the real keys.

# At least one provider key is required — the app refuses to start without one.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables third-party models via any OpenAI-compatible endpoint
# (OpenAI, OpenRouter, vLLM, Ollama, ...). Route requests with model values
# like "openai/gpt-4o-mini".
OPENAI_API_KEY=sk-...
# Optional — defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — HTTP port the app listens on (default: 3000).
PORT=3000

# Optional — set to "production" for raw NDJSON logs instead of pretty output,
# or "test" to silence logs entirely.
NODE_ENV=
